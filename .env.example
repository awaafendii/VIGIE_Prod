# ============================================================
# VIGIE — variables d'environnement (modèle)
# Copiez ce fichier en .env (local) et configurez les mêmes variables
# dans Vercel › Project › Settings › Environment Variables.
# NE COMMITTEZ JAMAIS le fichier .env rempli.
# ============================================================

# ---------- Front (exposé au navigateur : AUCUN secret ici) ----------
# Laissez vide pour appeler le backend en même origine (/api).
# Sinon, URL HTTPS d'un backend distinct (ex. https://api.mondomaine.com).
VITE_API_BASE=

# ---------- Authentification (Phase 1 — Supabase Auth) ----------
# Tant que ces deux variables front sont vides, l'auth est DÉSACTIVÉE
# et l'application reste en mode démonstration (aucune fonctionnalité retirée).
# La clé « anon » est PUBLIQUE par conception (la RLS protège les données).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Côté serveur (fonctions Vercel) — NE JAMAIS exposer au navigateur :
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé service_role : contourne la RLS. Secret absolu, serveur uniquement.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Backend CinetPay (secrets, jamais exposés au front) ----------
# Identifiants du compte marchand CinetPay (back-office › Intégrations / API).
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
# Bases d'API (valeurs par défaut correctes ; à surcharger seulement si besoin)
CINETPAY_BASE=https://api-checkout.cinetpay.com
CINETPAY_HISTO_BASE=https://api.cinetpay.com
# Jeton du webhook (en-tête x-token), si vous l'activez dans CinetPay (facultatif)
CINETPAY_NOTIFY_TOKEN=
# Jeton du webhook de VERSEMENTS (/api/banque/settlement-notify, en-tête
# x-settlement-token). Laissez VIDE pour DÉSACTIVER l'endpoint (404).
# Générez-en un : openssl rand -base64 32
SETTLEMENT_WEBHOOK_TOKEN=

# Origine exacte de l'application (anti-CSRF), ex. https://vigie.vercel.app
APP_ORIGIN=

# ---------- Chiffrement des secrets au repos (Phase 4, serveur uniquement) ----------
# Clé maître AES-256-GCM qui chiffre les identifiants marchand par PME
# (apikey CinetPay multi-marchand) avant stockage en base. SECRET ABSOLU :
# serveur uniquement, jamais VITE_, jamais commitée. Sans elle, l'enregistrement
# d'un connecteur marchand est refusé (aucun secret n'est stocké en clair).
# Générez-en une (32 octets) : openssl rand -base64 32
VIGIE_ENC_KEY=
# Version de la clé active (1..255, défaut 1). Incrémentez à chaque rotation.
VIGIE_ENC_KEY_VERSION=
# Anciennes clés, pour DÉCHIFFRER les secrets pas encore re-scellés pendant une
# rotation : "1:<ancienne_base64>,2:<autre_base64>". À vider une fois le
# re-scellement terminé (POST /api/admin/rotate-keys).
VIGIE_ENC_KEYS=
# Jeton d'exploitation protégeant /api/admin/rotate-keys (en-tête x-rotate-token).
# Laissez VIDE pour DÉSACTIVER l'endpoint (404). Générez-en un : openssl rand -base64 32
VIGIE_ROTATE_TOKEN=

# ---------- Stockage des transactions reçues par webhook ----------
# CinetPay n'a pas d'API de liste : le webhook enregistre les encaissements ici.
# Créez un store Vercel KV et liez-le au projet (ces variables sont injectées
# automatiquement par Vercel), puis : npm i @vercel/kv
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------- Endpoint de test sandbox (/api/banque/diagnostic) ----------
# Laissez VIDE en production (l'endpoint renvoie alors 404, désactivé).
# En recette, mettez un jeton long et secret ; envoyez-le dans l'en-tête
# x-sandbox-token pour valider le flux et injecter des transactions de test.
# Générez-en un : openssl rand -base64 32
SANDBOX_TOKEN=

# ---------- Facultatif ----------
# Réservé à un futur agrégateur OAuth ; non requis pour CinetPay.
# Générez-en un si besoin : openssl rand -base64 48
SESSION_SECRET=
